# Test credentials for the RLS suite (npm run test:rls). Copy to .env.test,
# which is git ignored. Do not commit, share or paste the real file anywhere.
#
# You do not need to fill these in by hand: npm run seed:dev generates any
# missing password, writes it here and sets it on the matching test user in
# atlas-dev. Fake test users only (CLAUDE.md rule 15). Never a real person.
#
# The suite also reads EXPO_PUBLIC_SUPABASE_URL and EXPO_PUBLIC_SUPABASE_ANON_KEY
# from .env, and refuses to run unless they point at atlas-dev.
# No service role key is needed or wanted here: the seed runs through the
# Supabase CLI login.

TEST_ADMIN_PASSWORD=
TEST_TEACHER_7A_PASSWORD=
TEST_TEACHER_7B_PASSWORD=
TEST_P1_PASSWORD=
TEST_P2_PASSWORD=
TEST_P3_PASSWORD=
TEST_P4_PASSWORD=
