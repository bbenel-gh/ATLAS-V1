{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(*supabase db reset*)",
      "Bash(*atlas-prod*)",
      "PowerShell(*atlas-prod*)",
      "PowerShell(*supabase db reset*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.ts"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/bright-only.ts"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-checks.ts"
            ],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
