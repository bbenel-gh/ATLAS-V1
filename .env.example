# Copy this file to .env and fill it in. .env is git ignored.
#
# CLAUDE.md rule 15: development uses the atlas-dev Supabase project.
# Never put production values in here.
#
# CLAUDE.md rule 1: the Claude API key lives only in Supabase secrets.
# It must never appear in this file, because anything prefixed EXPO_PUBLIC_
# is bundled into the app and readable by anyone holding the APK.

#
# The app checks every value at startup (src/data/env.ts) and refuses a
# secret or service_role key, a Claude key, or prod in a dev build.
# After editing .env, restart with: npx expo start --clear

# atlas-dev: Project Settings, API. Use the publishable (anon) key, never the secret key.
EXPO_PUBLIC_SUPABASE_URL=https://your-atlas-dev-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-atlas-dev-publishable-key

# Sentry: Project Settings, Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/0000000

# dev or prod. Always dev on this computer. prod is refused in a dev build.
EXPO_PUBLIC_APP_ENV=dev
